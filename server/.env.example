# Database (required)
DATABASE_URL="postgresql://crm:crm123@localhost:5432/crmdb"

# JWT — use a long random string in production (never commit real secrets)
JWT_SECRET="change-me-in-production-use-long-random-string"
PORT=4000
CLIENT_ORIGIN="http://localhost:5173"

# Logging: json | pretty
LOG_FORMAT="pretty"
# Set true in production to avoid leaking stack details to clients
LOG_REDACT="false"

# SMTP (Nodemailer) — password reset uses this when configured
SMTP_HOST=""
SMTP_PORT=587
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM="ServiceSphere <noreply@example.com>"
# Password reset link base (frontend URL) — e.g. https://app.example.com
PUBLIC_APP_URL="http://localhost:5173"

# Twilio WhatsApp
TWILIO_ACCOUNT_SID=""
TWILIO_AUTH_TOKEN=""
TWILIO_WHATSAPP_FROM="whatsapp:+14155238886"

# OpenAI
OPENAI_API_KEY=""
OPENAI_MODEL="gpt-4o-mini"

# IMAP inbound sync (optional)
IMAP_HOST=""
IMAP_PORT=993
IMAP_USER=""
IMAP_PASS=""
IMAP_TLS="true"
IMAP_MAILBOX="INBOX"
# Poll interval in ms (default 5min)
IMAP_SYNC_INTERVAL_MS="300000"

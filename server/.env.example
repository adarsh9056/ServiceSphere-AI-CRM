# Database (required)
DATABASE_URL="postgresql://crm:crm123@localhost:5432/crmdb"

# Redis — required in production for shared rate limits + login throttling (optional locally)
# REDIS_URL="redis://127.0.0.1:6379"

# JWT — use a long random string in production (≥32 chars; validated when NODE_ENV=production)
JWT_SECRET="change-me-in-production-use-long-random-string"
# Access token TTL (default 15m in production, 7d in dev). Refresh tokens rotate via refreshSession.
# JWT_ACCESS_EXPIRES_IN="15m"
# JWT_REFRESH_DAYS="30"
PORT=4000
CLIENT_ORIGIN="http://localhost:5173"
# Behind nginx/LB: forwarded client IP for rate limits
# TRUST_PROXY_HOPS="1"

# Public API origin for attachment download URLs (no trailing slash)
# PUBLIC_API_URL="https://api.example.com"

# File uploads (local disk; use S3 in production if you extend the uploader)
# UPLOAD_DIR="/var/lib/crm/uploads"
# UPLOAD_MAX_BYTES="15728640"

# Optional Sentry (GraphQL errors; use on API + worker for IMAP failures)
# SENTRY_DSN=""
# SENTRY_ENVIRONMENT="production"

# S3-compatible object storage for attachments (when set, local UPLOAD_DIR is not used for new files)
# AWS_REGION="us-east-1"
# S3_BUCKET="your-bucket"
# S3_PRESIGN_SECONDS="120"

# Refresh cookie (production cross-subdomain needs SameSite=None + Secure — see RUNBOOK)
# COOKIE_SECURE="true"
# COOKIE_SAMESITE="lax"

# Worker heartbeat log interval (ms)
# WORKER_HEARTBEAT_INTERVAL_MS="60000"

# Rate limits (optional overrides)
# RATE_LIMIT_GRAPHQL_MAX="2000"
# RATE_LIMIT_AUTH_MAX="60"
# LOGIN_MAX_ATTEMPTS_PER_WINDOW="8"
# LOGIN_LOCKOUT_MS="900000"

# Logging: json | pretty
LOG_FORMAT="pretty"
# Set true in production to avoid leaking stack details to clients
LOG_REDACT="false"

# SMTP (Nodemailer) — password reset uses this when configured
SMTP_HOST=""
SMTP_PORT=587
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM="ServiceSphere <noreply@example.com>"
# Password reset link base (frontend URL) — e.g. https://app.example.com
PUBLIC_APP_URL="http://localhost:5173"

# Twilio WhatsApp
TWILIO_ACCOUNT_SID=""
TWILIO_AUTH_TOKEN=""
TWILIO_WHATSAPP_FROM="whatsapp:+14155238886"

# OpenAI
OPENAI_API_KEY=""
OPENAI_MODEL="gpt-4o-mini"

# IMAP inbound sync (optional)
IMAP_HOST=""
IMAP_PORT=993
IMAP_USER=""
IMAP_PASS=""
IMAP_TLS="true"
# Local debugging only: set to "false" if your machine/network injects a self-signed
# TLS certificate and Node cannot trust it even with --use-system-ca.
IMAP_TLS_REJECT_UNAUTHORIZED="true"
IMAP_MAILBOX="INBOX"
# Max messages per sync run when catching up by UID (default 200)
IMAP_SYNC_BATCH_SIZE="200"
# Poll interval in ms (default 5min). For manual IMAP debugging, use e.g. 3600000 (1h) so
# background sync rarely races with "Run IMAP sync now".
IMAP_SYNC_INTERVAL_MS="300000"
# Set to "true" to skip the one-time IMAP sync on server boot (interval + manual button still run).
# Useful for manual testing or to avoid racing boot sync with a new message. Production: leave unset/false.
# IMAP_SKIP_BOOT_SYNC="true"
